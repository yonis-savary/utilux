#!/bin/sh

# This file holds the common configuration for utilux
# Remove the '#' before a line to un-comment it

# This file can be automatically updated with new content
# To do so, launch utilux-update-config

#   ___________________________
# _/ Core - Utilux core config \_

# Use custom terminal prompt (false by default)
#export UTILUX_ALLOW_PROMPT_CHANGE="true"


#   _________
# _/ Scripts \_

# If set to true, gxc will perform a dxd before checking out a branch and dxu after
#export UTILUX_GXC_CAN_USE_DOCKER="true"


#   _____________
# _/ Claude Code \_

export CLAUDE_CODE_SUBAGENT_MODEL="opus"
export CLAUDE_CODE_SUBAGENT_MODEL_FORCE="1"
export CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH="1"
export CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS="4"


#   __________________
# _/ Backup directory \_

# utilux-launch-backup command can help you sync a source and a target
# useful to sync your documents to an external disk

# To group all of your documents in one place, see utilux-skeln (modules/scripts/README.md)

# Source directory (local copy path, MUST END WITH A SLASH)
#export UTILUX_BACKUP_SOURCE="$HOME/.local/share/utilux/skeln/"

# Target directory (backup path, MUST END WITH A SLASH)
#export UTILUX_BACKUP_TARGET="/media/$USER/backupdisk/"


#   _______
# _/ Vault \_
# Used by utilux-vault, see modules/scripts/README.md

# Remote host, asked by utilux-vault mount when not set
#export UTILUX_VAULT_HOST=""
# Remote user ($USER by default)
#export UTILUX_VAULT_USER=""
# Remote vault directory, must exist (/home/$UTILUX_VAULT_USER/vault by default)
# ChrootDirectory : Give the path as seen from inside the chroot ! (e.g. /files/vault for /home/<user>/files/vault when chrooted in /home/<user>)
#export UTILUX_VAULT_REMOTE_PATH=""
