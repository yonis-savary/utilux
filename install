#!/bin/sh

# Sourced by the one-liner: return instead of exit, which would close the user shell
# Empêche l'exécution en tant que root
if [ "$EUID" = "0" ]
then
  echo "Please do not run this script as root"
  return 1 2>/dev/null || exit 1
fi

echo ""
echo "--- Utilux : bash/zsh utilities ---"
echo ""

SHELL_NAME=$(ps -hp $$ | awk '{print $5}')

if [ ! -z "$SHELL_NAME" ]; then
    SHELL_NAME=$(basename "$SHELL_NAME")
fi

if [ "$SHELL_NAME" = "zsh" ]
then
  RC_FILE="$HOME/.zshrc"
elif [ "$SHELL_NAME" = "bash" ]
then
  RC_FILE="$HOME/.bashrc"
else
  echo "Unsupported shell: $SHELL_NAME"
  return 1 2>/dev/null || exit 1
fi

if [ -f "$RC_FILE" ]; then
  if grep -q "utilux" "$RC_FILE"; then
    echo "Utilux is already installed (called by $RC_FILE)"
    return 0 2>/dev/null || exit 0
  fi
fi

echo "Installing utilux in $RC_FILE"
{
  echo "# utilux rc file"
  echo ". ~/utilux/.shellrc"
  echo ""
} >> "$RC_FILE"

. "$RC_FILE"

echo "Utilux installed in your $RC_FILE !"