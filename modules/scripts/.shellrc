#!/bin/sh

SCRIPT_DIR="$1"

if ! echo "$PATH" | grep -q "$SCRIPT_DIR/docker"; then
    export PATH="$PATH:$SCRIPT_DIR/claude"
    export PATH="$PATH:$SCRIPT_DIR/docker"
    export PATH="$PATH:$SCRIPT_DIR/git"
    export PATH="$PATH:$SCRIPT_DIR/utilux"
    export PATH="$PATH:$SCRIPT_DIR/utilux/utils"
    export PATH="$PATH:$HOME/.local/bin"
fi

source "$SCRIPT_DIR/.shellrc_comp"

alias dx="docker compose"
alias dxr="docker compose restart"
alias dxl="docker compose logs --follow"

_utilux_gxt_find() {
    if ! gxt find "$1"; then
        echo "No repository matches '$1'" >&2
        return 1
    fi
}

gxcode() {
    local repo_path
    repo_path=$(_utilux_gxt_find "$1") || return 1
    code "$repo_path" && exit
}

gxcd() {
    local repo_path
    repo_path=$(_utilux_gxt_find "$1") || return 1
    cd "$repo_path"
}

gxopen() {
    local repo_path
    repo_path=$(_utilux_gxt_find "$1") || return 1
    cd "$repo_path" && code . && claude
}


# "Command && Exit" variants

alias e="exit"
alias c="claude"