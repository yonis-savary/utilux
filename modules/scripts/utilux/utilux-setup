#!/bin/sh

if ! command -v whiptail >/dev/null 2>&1; then
    echo "utilux-setup needs whiptail : sudo apt install whiptail"
    exit 1
fi

SOFTWARES="git jq curl sqlite3 ffmpeg iproute2 net-tools sshfs 7zip htop nodejs npm filezilla firefox libreoffice gimp inkscape easytag asunder nvm docker php claude code wezterm"

is_selected() {
    case "$2" in
        *"\"$1\""*) return 0 ;;
        *) return 1 ;;
    esac
}

is_installed() {
    case "$1" in
        nvm)     [ -d "$HOME/.nvm" ] ;;
        7zip)    command -v 7z >/dev/null 2>&1 ;;
        wezterm) dpkg -s wezterm-nightly >/dev/null 2>&1 ;;
        docker|php|claude|code) command -v "$1" >/dev/null 2>&1 ;;
        *)       dpkg -s "$1" >/dev/null 2>&1 ;;
    esac
}

describe() {
    case "$1" in
        nvm)     echo "Node Version Manager " ;;
        wezterm) echo "WezTerm nightly " ;;
        docker)  echo "Docker + compose " ;;
        php)     echo "PHP + composer (php.new) " ;;
        claude)  echo "Claude Code " ;;
        code)    echo "Visual Studio Code " ;;
    esac
}

# Ubuntu 22.04 only ships 7z as p7zip-full, newer releases dropped it for 7zip
install_7zip() {
    if apt-cache show 7zip >/dev/null 2>&1; then
        sudo apt install -y 7zip
    else
        sudo apt install -y p7zip-full
    fi
}

install_nvm() {
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash
}

install_docker() {
    installer=$(mktemp)
    curl -fsSL https://get.docker.com -o "$installer"
    sh "$installer" --dry-run
    sudo sh "$installer"
    rm "$installer"
    sudo groupadd -f docker
    sudo usermod -aG docker "$USER"
    echo "Docker installed, log out and back in to use it without sudo"
}

install_php() {
    /bin/bash -c "$(curl -fsSL https://php.new/install/linux)"
}

install_claude() {
    curl -fsSL https://claude.ai/install.sh | bash
}

install_code() {
    utilux-install code
}

install_wezterm() {
    curl -fsSL https://apt.fury.io/wez/gpg.key | sudo gpg --yes --dearmor -o /usr/share/keyrings/wezterm-fury.gpg
    echo 'deb [signed-by=/usr/share/keyrings/wezterm-fury.gpg] https://apt.fury.io/wez/ * *' | sudo tee /etc/apt/sources.list.d/wezterm.list
    sudo chmod 644 /usr/share/keyrings/wezterm-fury.gpg
    sudo apt update
    sudo apt install -y wezterm-nightly
}


software_menu() {
    set --
    for software in $SOFTWARES; do
        status="MISSING"
        is_installed "$software" && status="INSTALLED"
        set -- "$@" "$software" "$(describe "$software")($status)" OFF
    done
    whiptail --checklist "Select the software to install" 22 78 14 "$@" 3>&1 1>&2 2>&3
}

selected_softwares=$(software_menu)

apt_packages=""
for software in $SOFTWARES; do
    is_selected "$software" "$selected_softwares" || continue
    if is_installed "$software"; then
        echo "$software already installed"
        continue
    fi
    command -v "install_$software" >/dev/null 2>&1 && continue
    apt_packages="$apt_packages $software"
done

if [ -n "$apt_packages" ]; then
    sudo apt install -y $apt_packages
fi

for software in $SOFTWARES; do
    is_selected "$software" "$selected_softwares" || continue
    command -v "install_$software" >/dev/null 2>&1 || continue
    is_installed "$software" && continue
    "install_$software"
done

utilux-setup-run apply-config "Select the utilux configs to apply"
