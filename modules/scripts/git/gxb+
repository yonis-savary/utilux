#!/bin/sh
branch_name="$1"
ticket_regex='^[A-Z]+-[0-9]+$'


if echo "$branch_name" | grep -E "$ticket_regex" > /dev/null; then

    echo "Making branch for ticket $branch_name"

    # axji is the canonical Jira fetch, it prints an epic as { issue, children }
    issue=$(axji "$branch_name" 2>/dev/null)

    if [ -z "$issue" ]; then
        echo "Could not fetch $branch_name from Jira, keeping the raw issue key"
    else
        fields=$(printf '%s\n' "$issue" | jq '.fields // .issue.fields')

        branch_type="feat"
        issue_type=$(printf '%s\n' "$fields" | jq '.issuetype.name' -r )
        if echo "$issue_type" | grep -qiE "bug"; then
            branch_type="fix"
        elif echo "$issue_type" | grep -qiE "epic"; then
            branch_type="epic"
        fi

        title=$(
            printf '%s\n' "$fields" | \
            jq '.summary' -r | \
            iconv -f utf8 -t ascii//TRANSLIT | \
            tr '[:upper:]' '[:lower:]' | \
            perl -pe "s/[a-z]\'//g" | \
            perl -pe "s/.+?\[.+?\]//g" | \
            perl -pe "s/[^0-9a-z]/ /g" | \
            perl -pe "s/^\s|\s+\$//g" | \
            perl -pe "s/\b\w{,3}\b//g" | \
            perl -pe "s/ +/-/g" | \
            perl -pe "s/^\-+|\-+$//g"
        )
        branch_name="$branch_type/$branch_name/$title"
    fi

fi

echo "Making branch $branch_name"

git checkout -b "$branch_name" "origin/$(gxb)"
